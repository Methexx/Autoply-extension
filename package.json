{
  "name": "autoply",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-drafted job application answers, reviewed by you before anything is submitted.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "lucide-react": "^1.51.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.89.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.0.279",
    "@types/node": "^26.6.4",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "4.3.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "25.0.1",
    "prettier": "3.9.9",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
